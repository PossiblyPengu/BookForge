{
  "name": "bookforge",
  "version": "1.0.0",
  "description": "Convert MP3 chapters into M4B audiobooks",
  "directories": {
    "doc": "docs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint docs/js/",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PossiblyPengu/BookForge.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/PossiblyPengu/BookForge/issues"
  },
  "homepage": "https://possiblypengu.github.io/BookForge/",
  "dependencies": {
    "@capacitor/android": "^7.6.7",
    "@capacitor/core": "^7.6.7",
    "@capacitor/ios": "^7.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.7",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "vitest": "^4.1.10"
  }
}
